<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />

            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.FastestLap"
        tools:targetApi="31">
        <activity
            android:name=".ui.junior.Formula3Activity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.junior.Formula2Activity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.welcome.WelcomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.welcome.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.home.HomePageActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.event.UpcomingEventsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.standing.ConstructorsStandingActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.standing.DriversStandingActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.event.EventActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.event.PastEventsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.bio.TrackBioActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.bio.ConstructorBioActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.bio.DriverBioActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:screenOrientation="portrait" />
        <!-- FileProvider for sharing generated .ics files with other apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ══ WIDGETS ══ -->

        <!-- Small widget (≈ 2×2) -->
        <receiver
            android:name=".widget.SmallWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="@string/widget_small_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>

        <!-- Medium widget (≈ 3×2) -->
        <receiver
            android:name=".widget.MediumWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="@string/widget_medium_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium_info" />
        </receiver>

        <!-- Large widget (≈ 4×3) -->
        <receiver
            android:name=".widget.LargeWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="@string/widget_large_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>

        <!-- Background service that fetches data and pushes RemoteViews updates -->
        <service
            android:name=".widget.WidgetUpdateService"
            android:exported="false" />

    </application>

</manifest>