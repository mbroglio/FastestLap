<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/timer_gray_dark" />
            <size
                android:width="120dp"
                android:height="120dp" />
        </shape>
    </item>

    <!-- Inner circle -->
    <item
        android:top="8dp"
        android:left="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/timer_gray" />
        </shape>
    </item>
</layer-list>

