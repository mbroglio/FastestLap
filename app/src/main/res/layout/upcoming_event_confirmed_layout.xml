<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Round Tag -->
    <TextView
        android:id="@+id/upcoming_round_number"
        style="@style/t10UpperCaseBoldWhiteLineLimited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="@string/not_found"
        android:textColor="@color/app_primary_red" />

    <!-- Grand Prix Name -->
    <TextView
        android:id="@+id/upcoming_gp_name"
        style="@style/t14BoldWhiteLineLimited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/upcoming_round_number"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/icon_layout"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/not_found" />

    <!-- Weekend Date Information -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/upcoming_gp_name"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/icon_layout"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/upcoming_date"
            style="@style/t14BoldWhiteLineLimited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_found" />

        <TextView
            android:id="@+id/upcoming_month"
            style="@style/t12UpperCaseBoldWhiteLineLimited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/not_found" />

    </LinearLayout>

    <!-- Navigation Icon / Live Indicator -->
    <RelativeLayout
        android:id="@+id/icon_layout"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="2dp">

        <ImageView
            android:id="@+id/access_event_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_centerInParent="true"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/play_icon_white"
            app:tint="@color/timer_gray" />

        <RelativeLayout
            android:id="@+id/live_event_icon_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/upcoming_event_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/dot_inside_a_circle_red" />

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>