<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/junior_team_card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/medium_margin"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="@dimen/medium_margin"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_surface_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:rippleColor="@color/ripple_color"
    app:strokeColor="@color/subtle_white_border"
    app:strokeWidth="1.5dp">

    <!-- Team Card Container with Gradient Background -->
    <LinearLayout
        android:id="@+id/junior_team_card_inner_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Semi-transparent Dark Surface Overlay for premium contrast & elegance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D01C1D24"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header Row: Team Logo Badge, Team Name, and Lineup Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Team Logo Badge Container -->
                <FrameLayout
                    android:id="@+id/team_logo_container"
                    android:layout_width="54dp"
                    android:layout_height="38dp"
                    android:background="@drawable/team_logo_badge_background"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/team_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/prema_logo" />
                </FrameLayout>

                <!-- Team Name -->
                <TextView
                    android:id="@+id/team_name"
                    style="@style/t16BoldWhite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/orbitron_bold"
                    android:gravity="start|center_vertical"
                    android:maxLines="2"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="PREMA Racing" />

            </LinearLayout>

            <!-- Horizontal Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/subtle_white_border" />

            <!-- Drivers Lineup List -->
            <LinearLayout
                android:id="@+id/drivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Driver 1 -->
                <LinearLayout
                    android:id="@+id/driver_1_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/badge_pill_translucent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/driver_1_name"
                        style="@style/t14BoldWhiteLineLimited"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:text="Andrea Kimi Antonelli" />

                </LinearLayout>

                <!-- Driver 2 -->
                <LinearLayout
                    android:id="@+id/driver_2_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/badge_pill_translucent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/driver_2_name"
                        style="@style/t14BoldWhiteLineLimited"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:text="Oliver Bearman" />

                </LinearLayout>

                <!-- Driver 3 (Visible for Formula 3, Gone for Formula 2) -->
                <LinearLayout
                    android:id="@+id/driver_3_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/badge_pill_translucent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/driver_3_name"
                        style="@style/t14BoldWhiteLineLimited"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:text="Dino Beganovic" />

                </LinearLayout>

            </LinearLayout>

            <!-- Car Image Section -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/car_image"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="2dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>