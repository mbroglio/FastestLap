<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/position_text"
        style="@style/t14RegularWhiteLineLimited"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center" />

    <View
        android:id="@+id/team_color_indicator"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/driver_name"
        style="@style/t14BoldWhiteLineLimited"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:gravity="start|center" />

    <TextView
        android:id="@+id/team_name"
        style="@style/t12RegularWhiteLineLimited"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:gravity="center" />

    <TextView
        android:id="@+id/status"
        style="@style/t12RegularWhiteLineLimited"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="0.6"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="5dp"
        android:layout_weight="0.4"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/delta_position_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter">

        </ImageView>

        <TextView
            android:id="@+id/delta_position_text"
            style="@style/t12BoldWhiteLineLimited"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

        </TextView>

    </LinearLayout>

</LinearLayout>