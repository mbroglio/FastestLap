<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.weather.WeatherActivity">

    <VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:background="@android:color/transparent"
            app:menu="@menu/weather_menu"
            app:navigationIcon="@drawable/arrow_back_ios_style">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/medium_margin">

                <TextView
                    android:id="@+id/topAppBarTitle"
                    style="@style/t25UpperCaseBoldWhite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:maxLines="1">

                </TextView>

            </RelativeLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/weather_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar_layout">

        <ScrollView
            android:id="@+id/weather_main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_bar_layout">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/today_text"
                    style="@style/t14UpperCaseBoldWhite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_marginTop="5dp"
                    android:gravity="start"
                    android:text="@string/today">

                </TextView>

                <TextView
                    android:id="@+id/today_date_text"
                    style="@style/t14RegularWhite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_toEndOf="@+id/today_text">

                </TextView>

                <RelativeLayout
                    android:id="@+id/temperature_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/today_text"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/weather_text"
                        style="@style/t20BoldWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_centerInParent="true">

                    </TextView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/weather_text"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="40dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/temp_min_text"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center">

                            </TextView>

                            <TextView
                                android:id="@+id/temp_current_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/orbitron_bold"
                                android:gravity="center"
                                android:textAppearance="@style/TextAppearance.AppCompat.Display2"
                                android:textColor="@color/white">

                            </TextView>

                            <TextView
                                android:id="@+id/temp_max_text"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center">

                            </TextView>


                        </LinearLayout>

                        <ImageView
                            android:id="@+id/weather_icon"
                            android:layout_width="@dimen/driver_photo_in_card"
                            android:layout_height="@dimen/driver_photo_in_card"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no">

                        </ImageView>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="40dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/t12UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="@string/track">

                                </TextView>

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="5dp"
                                    app:srcCompat="@drawable/road_icon">

                                </ImageView>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/track_temp_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/orbitron_bold"
                                android:gravity="center"
                                android:textAppearance="@style/TextAppearance.AppCompat.Display2"
                                android:textColor="@color/white">

                            </TextView>


                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/humidity_rain_probability_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/temperature_layout"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/humidity_text"
                            style="@style/t14BoldWhiteLineLimited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/humidity">

                        </TextView>

                        <TextView
                            android:id="@+id/humidity_value_text"
                            style="@style/t14RegularWhiteLineLimited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp">

                        </TextView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/rain_probability_text"
                            style="@style/t14BoldWhiteLineLimited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/orbitron_bold"
                            android:text="@string/rain_probability"
                            android:textColor="@color/white">

                        </TextView>

                        <TextView
                            android:id="@+id/rain_prob_value_text"
                            style="@style/t14RegularWhiteLineLimited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp">

                        </TextView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pressure_text"
                            style="@style/t14BoldWhiteLineLimited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/orbitron_bold"
                            android:text="Pressure:"
                            android:textColor="@color/white">

                        </TextView>

                        <TextView
                            android:id="@+id/pressure_value_text"
                            style="@style/t14RegularWhiteLineLimited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp">

                        </TextView>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wind_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/humidity_rain_probability_layout"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/driver_photo_in_card"
                        android:layout_height="@dimen/driver_photo_in_card"
                        app:srcCompat="@drawable/windsock_icon">

                    </ImageView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/wind_direction_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/orbitron_bold"
                                android:text="Direction:"
                                android:textColor="@color/white">

                            </TextView>

                            <TextView
                                android:id="@+id/wind_dir_value_text"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp">

                            </TextView>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/wind_speed_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/orbitron_bold"
                                android:text="@string/speed_index"
                                android:textColor="@color/white">

                            </TextView>

                            <TextView
                                android:id="@+id/wind_speed_value_text"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp">

                            </TextView>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/wind_gust_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/orbitron_bold"
                                android:text="@string/gust"
                                android:textColor="@color/white">

                            </TextView>

                            <TextView
                                android:id="@+id/wind_gust_value_text"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp">

                            </TextView>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/weekend_forecast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/wind_layout"
                    android:layout_alignStart="@id/wind_layout"
                    android:layout_marginTop="30dp">

                    <TextView
                        android:id="@+id/weekend_forecast_text"
                        style="@style/t18UpperCaseBoldWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:text="@string/race_weekend_forecast">

                    </TextView>

                    <TextView
                        android:id="@+id/weather_not_available_text"
                        style="@style/t18BoldWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/weekend_forecast_text"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:text="@string/meteo_not_available_yet"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/weekend_forecast_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/weather_not_available_text"
                        android:layout_alignStart="@id/weekend_forecast_text"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/day_1_row"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="40dp"
                            android:background="@drawable/background_bottom_margin_3_dp_white"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/day_1_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="75dp"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerInParent="true"
                                android:text="@string/friday">

                            </TextView>

                            <TextView
                                android:id="@+id/day_1_date"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_toEndOf="@id/day_1_text">

                            </TextView>

                            <ImageView
                                android:id="@+id/day_1_weather_icon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_marginStart="25dp"
                                android:layout_marginBottom="3dp"
                                android:layout_toEndOf="@id/day_1_date">

                            </ImageView>

                            <TextView
                                android:id="@+id/day_1_temp_max"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="70dp"
                                android:layout_toEndOf="@+id/day_1_weather_icon">

                            </TextView>

                            <TextView
                                android:id="@+id/day_1_temp_min"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@+id/day_1_temp_max">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/day_2_row"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="40dp"
                            android:background="@drawable/background_bottom_margin_3_dp_white"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/day_2_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="75dp"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerInParent="true"
                                android:text="@string/saturday">

                            </TextView>

                            <TextView
                                android:id="@+id/day_2_date"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_toEndOf="@id/day_2_text">

                            </TextView>

                            <ImageView
                                android:id="@+id/day_2_weather_icon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_marginStart="25dp"
                                android:layout_marginBottom="3dp"
                                android:layout_toEndOf="@id/day_2_date">

                            </ImageView>

                            <TextView
                                android:id="@+id/day_2_temp_max"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="70dp"
                                android:layout_toEndOf="@+id/day_2_weather_icon">

                            </TextView>

                            <TextView
                                android:id="@+id/day_2_temp_min"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@+id/day_2_temp_max">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/day_3_row"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="40dp"
                            android:background="@drawable/background_bottom_margin_3_dp_white"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/day_3_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="75dp"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerInParent="true"
                                android:text="@string/sunday">

                            </TextView>

                            <TextView
                                android:id="@+id/day_3_date"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_toEndOf="@id/day_3_text">

                            </TextView>

                            <ImageView
                                android:id="@+id/day_3_weather_icon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_marginStart="25dp"
                                android:layout_marginBottom="3dp"
                                android:layout_toEndOf="@id/day_3_date">

                            </ImageView>

                            <TextView
                                android:id="@+id/day_3_temp_max"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="70dp"
                                android:layout_toEndOf="@+id/day_3_weather_icon">

                            </TextView>

                            <TextView
                                android:id="@+id/day_3_temp_min"
                                style="@style/t14RegularWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@+id/day_3_temp_max">

                            </TextView>

                        </RelativeLayout>

                    </LinearLayout>

                </RelativeLayout>

            </RelativeLayout>

        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/loading_screen"
        layout="@layout/loading_screen"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>