<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_color"
    tools:context=".ui.live.fragment.LiveEventFragment">

    <LinearLayout
        android:id="@+id/live_action_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_track_map"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="#D32F2F"
            android:fontFamily="@font/orbitron_bold"
            android:text="🏎️ APRI MAPPA LIVE TRACCIATO"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/live_table_rows"
        android:layout_width="match_parent"
        android:layout_marginTop="0dp"
        android:layout_height="25dp"
        android:layout_below="@id/live_action_bar_container">

        <include
            android:id="@+id/race_header_short"
            layout="@layout/live_race_table_header_short"
            android:visibility="visible"/>

        <include
            android:id="@+id/race_header_full"
            layout="@layout/live_race_table_header_full"
            android:visibility="gone"/>

        <include
            android:id="@+id/qualifying_header_full"
            layout="@layout/live_qualifying_table_header_full"
            android:visibility="gone"/>

        <include
            android:id="@+id/qualifying_header_short"
            layout="@layout/live_qualifying_table_header_short"
            android:visibility="gone"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:scrollbars="none"
        android:layout_marginTop="0dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_height="0dp"
        android:layout_below="@id/live_table_rows"
        android:layout_alignParentBottom="true">

        <TableLayout
            android:id="@+id/live_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        </TableLayout>

    </ScrollView>

</RelativeLayout>