<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/team_card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/medium_margin"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="@dimen/medium_margin"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_surface_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:rippleColor="@color/ripple_color"
    app:strokeColor="@color/subtle_white_border"
    app:strokeWidth="1.5dp"
    tools:context=".ui.standing.ConstructorsStandingActivity">

    <!-- Not Found / Error State -->
    <TextView
        android:id="@+id/constructor_not_found"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="@dimen/layout_subtitle_text_size"
        android:autoSizeMinTextSize="@dimen/text_minor_importance_size"
        android:autoSizeTextType="uniform"
        android:background="@color/card_surface_elevated"
        android:fontFamily="@font/orbitron_bold"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="@dimen/medium_margin"
        android:paddingEnd="@dimen/medium_margin"
        android:textColor="@color/white"
        android:textSize="@dimen/layout_subtitle_text_size"
        android:visibility="gone" />

    <!-- Team Card Container with Gradient Background -->
    <LinearLayout
        android:id="@+id/team_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Semi-transparent Dark Surface Overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D01C1D24"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Header Row: Position, Logo, Team Name, Points -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Team Position -->
                <TextView
                    android:id="@+id/team_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/orbitron_bold"
                    android:gravity="center"
                    android:minWidth="24dp"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="1" />

                <!-- Vertical Separator after Position -->
                <View
                    android:id="@+id/pos_separator"
                    android:layout_width="1.5dp"
                    android:layout_height="18dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/team_position"
                    android:background="@color/subtle_white_border" />

                <!-- Team Logo Badge Container -->
                <FrameLayout
                    android:id="@+id/team_logo_container"
                    android:layout_width="44dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/pos_separator"
                    android:background="@drawable/team_logo_badge_background"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/team_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <!-- Points Pill Badge (Top Right) -->
                <LinearLayout
                    android:id="@+id/points_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/badge_pill_translucent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/team_points"
                        style="@style/t14BoldWhiteLineLimited"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/orbitron_bold"
                        android:textColor="@color/white"
                        tools:text="593" />

                    <TextView
                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/points_upper_case"
                        android:textColor="@color/modern_light_gray" />
                </LinearLayout>

                <!-- Team Name -->
                <TextView
                    android:id="@+id/team_name"
                    style="@style/t16BoldWhite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_toEndOf="@id/team_logo_container"
                    android:layout_toStartOf="@id/points_container"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:maxLines="2"
                    android:textColor="@color/white"
                    tools:text="McLaren F1 Team" />

            </RelativeLayout>

            <!-- Horizontal Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/subtle_white_border" />

            <!-- Body Row: Drivers (Left) & Car Image (Right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left Column: Drivers -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.48"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <!-- Driver 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/driver_1_pic"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.FastestLap.Circular"
                            app:strokeColor="@color/subtle_white_border"
                            app:strokeWidth="1.5dp" />

                        <TextView
                            android:id="@+id/driver_1_name"
                            style="@style/t12BoldWhiteLineLimited"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:maxLines="2"
                            android:textColor="@color/white"
                            tools:text="L. Norris" />

                    </LinearLayout>

                    <!-- Driver 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/driver_2_pic"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.FastestLap.Circular"
                            app:strokeColor="@color/subtle_white_border"
                            app:strokeWidth="1.5dp" />

                        <TextView
                            android:id="@+id/driver_2_name"
                            style="@style/t12BoldWhiteLineLimited"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:maxLines="2"
                            android:textColor="@color/white"
                            tools:text="O. Piastri" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Vertical subtle separator between Drivers and Car -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/subtle_white_border" />

                <!-- Right Column: Car Image -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="0.52">

                    <ImageView
                        android:id="@+id/car_image"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>