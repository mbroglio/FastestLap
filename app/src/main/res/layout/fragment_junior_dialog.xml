<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="0dp"
    app:strokeWidth="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_background_color"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_title"
                style="@style/t25UpperCaseBoldBlack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="5dp"
                android:gravity="center"
                android:maxLines="1"
                android:visibility="visible" />

            <TextView
                android:id="@+id/race_type_title"
                style="@style/t20UpperCaseBoldBlack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="5dp"
                android:gravity="center"
                android:maxLines="1"
                android:visibility="visible" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/junior_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@id/race_info_layout"
            android:layout_below="@id/title_layout"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/race_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/close_button"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginEnd="@dimen/medium_margin"
            android:layout_marginBottom="5dp"
            android:orientation="vertical"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/pole_position_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@color/timer_gray"
                android:padding="5dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/pole_position_image"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/grid_icon">

                </ImageView>

                <LinearLayout
                    android:id="@+id/pole_position_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/pole_position_image"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/t14UpperCaseBoldBlack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:text="@string/pole_position">

                    </TextView>

                    <TextView
                        android:id="@+id/driver_name_pole"
                        style="@style/t12BoldBlackLineLimited"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="start|center" />

                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/fastest_lap_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/timer_gray"
                android:padding="5dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/fastest_lap_image"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/fastest_lap_icon">

                </ImageView>

                <LinearLayout
                    android:id="@+id/fastest_lap_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/fastest_lap_image"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/t14UpperCaseBoldBlack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:text="@string/fastest_lap">

                    </TextView>

                    <TextView
                        android:id="@+id/driver_name_fastest_lap"
                        style="@style/t12BoldBlackLineLimited"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="start|center" />

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

        <Button
            android:id="@+id/close_button"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginEnd="@dimen/medium_margin"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/orbitron_bold"
            android:paddingBottom="5dp"
            android:text="@string/close"
            android:textColor="@color/black">

        </Button>
    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>