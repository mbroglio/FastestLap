<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/race_result"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/race_text"
        style="@style/t12UpperCaseBoldWhiteLineLimited"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="@string/race_result" />

    <LinearLayout
        android:id="@+id/race_podium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/race_text"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!-- 1st Place -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/t12BoldWhiteLineLimited"
                android:layout_width="14dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/_1_numeric"
                android:textColor="#FFD700" />

            <LinearLayout
                android:id="@+id/first_color"
                android:layout_width="4dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/first_name"
                style="@style/t12BoldWhiteLineLimited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/not_found"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- 2nd Place -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/t12BoldWhiteLineLimited"
                android:layout_width="14dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/_2_numeric"
                android:textColor="#C0C0C0" />

            <LinearLayout
                android:id="@+id/second_color"
                android:layout_width="4dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/second_name"
                style="@style/t12BoldWhiteLineLimited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/not_found"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- 3rd Place -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/t12BoldWhiteLineLimited"
                android:layout_width="14dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/_3_numeric"
                android:textColor="#CD7F32" />

            <LinearLayout
                android:id="@+id/third_color"
                android:layout_width="4dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/third_name"
                style="@style/t12BoldWhiteLineLimited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/not_found"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
