<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/timer_gray"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/black"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════════════════════
             PANNELLO INFO  (visibile di default, nascosto durante play)
             ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/team_radio_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- Icona headphones -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/headphones_icon"
                android:scaleType="fitCenter" />

            <!-- Testi pilota + orario -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/team_radio_driver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/t14UpperCaseBoldBlack" />

                <TextView
                    android:id="@+id/driver_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    style="@style/t12RegularBlackLineLimited" />

            </LinearLayout>

            <!-- Pulsante play + spinner buffering sovrapposti -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/team_radio_play_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/play_64"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true" />

                <ProgressBar
                    android:id="@+id/team_radio_loading"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════
             PANNELLO PLAYER  (nascosto di default, visibile durante play)
             ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/team_radio_player_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <!-- Riga superiore: titolo pilota + pulsante chiudi (torna al pannello info) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/headphones_icon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/team_radio_player_driver_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/t14UpperCaseBoldBlack" />

                <!-- Pulsante X per chiudere il player e tornare al pannello info -->
                <ImageView
                    android:id="@+id/team_radio_close_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <!-- Barra di avanzamento (SeekBar) -->
            <SeekBar
                android:id="@+id/team_radio_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:max="100"
                android:progress="0"
                android:thumbTint="@color/black"
                android:progressTint="@color/black"
                android:progressBackgroundTint="@color/timer_gray_dark" />

            <!-- Riga inferiore: tempo trascorso | pulsanti pausa + riavvia | durata totale -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Tempo trascorso -->
                <TextView
                    android:id="@+id/team_radio_time_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/black"
                    android:fontFamily="@font/orbitron_regular"
                    android:textSize="11sp" />

                <!-- Spazio flessibile a sinistra dei pulsanti -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Pulsante riavvia -->
                <ImageView
                    android:id="@+id/team_radio_restart_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/restart_icon"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no" />

                <!-- Pulsante pausa / riprendi -->
                <ImageView
                    android:id="@+id/team_radio_pause_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/pause_64"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no" />

                <!-- Spazio flessibile a destra dei pulsanti -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Durata totale -->
                <TextView
                    android:id="@+id/team_radio_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/black"
                    android:fontFamily="@font/orbitron_regular"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
