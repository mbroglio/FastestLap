<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_color">

    <LinearLayout
        android:id="@+id/chart_main_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- TOGGLE BUTTONS: RACES & SPRINTS vs QUALIFYINGS -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_button_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:checkedButton="@+id/btn_toggle_races"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_races"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/races"
                android:textColor="@color/white"
                android:textSize="@dimen/body_text_size"
                android:fontFamily="@font/orbitron_bold"
                android:autoSizeMaxTextSize="@dimen/body_text_size"
                android:autoSizeMinTextSize="@dimen/min_text_resize_1"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                app:backgroundTint="@color/card_surface_elevated"
                app:strokeColor="@color/subtle_white_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_sprints"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sprints"
                android:textColor="@color/white"
                android:textSize="@dimen/body_text_size"
                android:fontFamily="@font/orbitron_bold"
                android:autoSizeMaxTextSize="@dimen/body_text_size"
                android:autoSizeMinTextSize="@dimen/min_text_resize_1"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                app:backgroundTint="@color/card_surface_dark"
                app:strokeColor="@color/subtle_white_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_qualifyings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/qualifying"
                android:textColor="@color/white"
                android:textSize="@dimen/body_text_size"
                android:fontFamily="@font/orbitron_bold"
                android:autoSizeMaxTextSize="@dimen/body_text_size"
                android:autoSizeMinTextSize="@dimen/min_text_resize_1"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                app:backgroundTint="@color/card_surface_dark"
                app:strokeColor="@color/subtle_white_border" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- CHART CARD CONTAINER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/card_surface_dark"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/subtle_white_border"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Chart Horizontal Split (Sticky Y-Axis + Scrollable Chart) -->
                <LinearLayout
                    android:id="@+id/chart_content_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <!-- Fixed Sticky Y-Axis View -->
                    <com.the_coffe_coders.fastestlap.util.chart.StickyYAxisView
                        android:id="@+id/sticky_y_axis_view"
                        android:layout_width="48dp"
                        android:layout_height="match_parent" />

                    <!-- Horizontally Scrollable Chart Area -->
                    <HorizontalScrollView
                        android:id="@+id/chart_scroll_view"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:scrollbars="horizontal">

                        <com.the_coffe_coders.fastestlap.util.chart.SeasonProgressionChartView
                            android:id="@+id/season_progression_chart_view"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent" />
                    </HorizontalScrollView>

                </LinearLayout>

                <!-- Loading Spinner (fallback) -->
                <ProgressBar
                    android:id="@+id/chart_loading_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/app_primary_red"
                    android:visibility="gone" />

                <!-- Empty State Message -->
                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/chart_empty_message"
                    style="@style/t12BoldWhiteLineLimited"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="24dp"
                    android:gravity="center"
                    android:text="@string/data_not_available"
                    android:textColor="@color/timer_gray"
                    android:visibility="gone" />
            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/drivers_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/circular_background"
                        android:layout_gravity="center">

                    </View>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Sebastian Vettel">
                    </TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/circular_background"
                        android:layout_gravity="center">

                    </View>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Lewis Hamilton">
                    </TextView>

                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/t10UpperCaseBoldWhiteLineLimited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/drivers_layout"
                android:layout_marginEnd="8dp"
                android:gravity="end"
                android:fontFamily="@font/orbitron_regular"
                android:text="@string/scroll_indication"
                android:textColor="@color/timer_gray" />

        </RelativeLayout>

    </LinearLayout>

    <include
        android:id="@+id/loading_screen"
        layout="@layout/loading_screen"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
