<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_color">

    <LinearLayout
        android:id="@+id/chart_main_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- TOGGLE BUTTONS: RACES & SPRINTS vs QUALIFYINGS -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_button_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:checkedButton="@+id/btn_toggle_races"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_races"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/orbitron_bold"
                android:text="@string/races_sprints"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@color/card_surface_elevated"
                app:strokeColor="@color/subtle_white_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_qualifyings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/orbitron_bold"
                android:text="@string/qualifying"
                android:textColor="@color/timer_gray"
                android:textSize="12sp"
                app:backgroundTint="@color/card_surface_dark"
                app:strokeColor="@color/subtle_white_border" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- CHART CARD CONTAINER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/card_surface_dark"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/subtle_white_border"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Chart Horizontal Split (Sticky Y-Axis + Scrollable Chart) -->
                <LinearLayout
                    android:id="@+id/chart_content_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <!-- Fixed Sticky Y-Axis View -->
                    <com.the_coffe_coders.fastestlap.util.chart.StickyYAxisView
                        android:id="@+id/sticky_y_axis_view"
                        android:layout_width="48dp"
                        android:layout_height="match_parent" />

                    <!-- Horizontally Scrollable Chart Area -->
                    <HorizontalScrollView
                        android:id="@+id/chart_scroll_view"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:scrollbars="horizontal">

                        <com.the_coffe_coders.fastestlap.util.chart.SeasonProgressionChartView
                            android:id="@+id/season_progression_chart_view"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Loading Spinner (fallback) -->
                <ProgressBar
                    android:id="@+id/chart_loading_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/app_primary_red"
                    android:visibility="gone" />

                <!-- Empty State Message -->
                <TextView
                    android:id="@+id/chart_empty_message"
                    style="@style/t12BoldWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="24dp"
                    android:gravity="center"
                    android:text="Nessun dato di gara registrato per la stagione corrente"
                    android:textColor="@color/timer_gray"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FOOTER / LEGEND -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Primary Series Legend -->
            <View
                android:id="@+id/legend_finish_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="0dp"
                android:backgroundTint="@color/app_primary_red" />

            <TextView
                android:id="@+id/legend_finish_text"
                style="@style/t12RegularWhiteLineLimited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/orbitron_regular"
                android:text="@string/race"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <!-- Secondary Series Legend -->
            <View
                android:id="@+id/legend_secondary_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="16dp"
                android:backgroundTint="@color/app_primary_red"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_secondary_text"
                style="@style/t12RegularWhiteLineLimited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/orbitron_regular"
                android:text="@string/secondary_driver"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Scroll indication -->
            <TextView
                style="@style/t10UpperCaseBoldWhiteLineLimited"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_regular"
                android:text="@string/scroll_indication"
                android:textColor="@color/timer_gray" />

        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/loading_screen"
        layout="@layout/loading_screen"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
