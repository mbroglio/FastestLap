<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_driver_bio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_color"
    tools:context=".ui.bio.DriverBioActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            app:menu="@menu/bio_menu"
            app:navigationIcon="@drawable/arrow_back_ios_style">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/topAppBarTitle"
                    style="@style/t25UpperCaseBoldBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:maxLines="1" />

            </RelativeLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/driver_bio_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/screen_background_color"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar_layout">

        <ScrollView
            android:id="@+id/driver_bio_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/screen_background_color"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- UNIFIED DRIVER INFO CARD (TEAM LOGO, FLAG, PORTRAIT & BIOGRAPHICAL STATS) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/driver_info_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/card_surface_elevated"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/subtle_white_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- TOP ROW: TEAM LOGO & DRIVER FLAG -->
                        <LinearLayout
                            android:id="@+id/team_logo_and_driver_flag"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.65">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/team_logo_card"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="2dp"
                                    app:cardBackgroundColor="@color/team_card_modern_gray"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="2dp"
                                    app:strokeColor="@color/subtle_white_border"
                                    app:strokeWidth="1.5dp">

                                    <ImageView
                                        android:id="@+id/team_logo_image"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_margin="8dp"
                                        android:importantForAccessibility="no"
                                        android:scaleType="fitCenter" />

                                </com.google.android.material.card.MaterialCardView>

                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.35">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/driver_flag_card"
                                    android:layout_width="54dp"
                                    android:layout_height="36dp"
                                    android:layout_centerInParent="true"
                                    app:cardBackgroundColor="@color/card_surface_elevated"
                                    app:cardCornerRadius="6dp"
                                    app:cardElevation="2dp"
                                    app:strokeColor="@color/subtle_white_border"
                                    app:strokeWidth="1dp">

                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/driver_flag"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:importantForAccessibility="no"
                                        android:scaleType="centerCrop"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.FastestLap.RoundedFlag" />

                                </com.google.android.material.card.MaterialCardView>

                            </RelativeLayout>

                        </LinearLayout>

                        <!-- HORIZONTAL SEPARATOR BETWEEN LOGO/FLAG AND PILOT/STATS -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/subtle_white_border" />

                        <!-- BOTTOM ROW: DRIVER PORTRAIT + STATS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Driver Portrait -->
                            <ImageView
                                android:id="@+id/driver_bio_pic"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="0.9"
                                android:adjustViewBounds="true"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter" />

                            <!-- Vertical Subtle Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp"
                                android:background="@color/subtle_white_border" />

                            <!-- Driver Stats Column -->
                            <LinearLayout
                                android:id="@+id/driver_stats"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1.1"
                                android:orientation="vertical">

                                <!-- Place of Birth -->
                                <TextView
                                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="start"
                                    android:text="@string/place_of_birth_index"
                                    android:textColor="@color/timer_gray" />

                                <TextView
                                    android:id="@+id/driver_birthplace"
                                    style="@style/t12BoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="start"
                                    android:text="@string/not_found" />

                                <!-- Date of Birth -->
                                <TextView
                                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="start"
                                    android:text="@string/date_of_birth_index"
                                    android:textColor="@color/timer_gray" />

                                <TextView
                                    android:id="@+id/driver_birthdate"
                                    style="@style/t12BoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="start"
                                    android:text="@string/not_found" />

                                <!-- Age -->
                                <TextView
                                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="start"
                                    android:text="@string/age_index"
                                    android:textColor="@color/timer_gray" />

                                <TextView
                                    android:id="@+id/driver_age"
                                    style="@style/t12BoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="start"
                                    android:text="@string/not_found" />

                                <!-- Weight / Height -->
                                <TextView
                                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="start"
                                    android:text="@string/weight_height_index"
                                    android:textColor="@color/timer_gray" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical|start"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/driver_weight"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/not_found" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="3dp"
                                        android:fontFamily="@font/orbitron_regular"
                                        android:text="@string/kg"
                                        android:textColor="@color/timer_gray"
                                        android:textSize="@dimen/text_minor_importance_size" />

                                    <TextView
                                        style="@style/t12RegularWhiteLineLimited"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/separator_high_dash"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/driver_height"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/not_found" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="3dp"
                                        android:fontFamily="@font/orbitron_regular"
                                        android:text="@string/m"
                                        android:textColor="@color/timer_gray"
                                        android:textSize="@dimen/text_minor_importance_size" />

                                </LinearLayout>

                                <!-- Best Result -->
                                <TextView
                                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="start"
                                    android:text="@string/best_result_index"
                                    android:textColor="@color/timer_gray" />

                                <TextView
                                    android:id="@+id/driver_best_result"
                                    style="@style/t12BoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="start"
                                    android:text="@string/not_found" />

                                <!-- Podiums -->
                                <TextView
                                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="start"
                                    android:text="@string/podiums_index"
                                    android:textColor="@color/timer_gray" />

                                <TextView
                                    android:id="@+id/driver_podiums"
                                    style="@style/t12BoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="start"
                                    android:text="@string/not_found" />

                                <!-- Championships -->
                                <TextView
                                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="start"
                                    android:text="@string/championships_index"
                                    android:textColor="@color/timer_gray" />

                                <TextView
                                    android:id="@+id/driver_championships"
                                    style="@style/t12BoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="start"
                                    android:text="@string/not_found" />

                                <!-- First Entry -->
                                <TextView
                                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="start"
                                    android:text="@string/first_entry_index"
                                    android:textColor="@color/timer_gray" />

                                <TextView
                                    android:id="@+id/driver_first_entry"
                                    style="@style/t12BoldWhiteLineLimited"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="start"
                                    android:text="@string/not_found" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- TACHOMETERS & RACING NUMBER (OUTSIDE CARD) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.the_coffe_coders.fastestlap.util.ui.TachometerView
                            android:id="@+id/win_percentage_tachometer_driver"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="28dp" />

                        <com.the_coffe_coders.fastestlap.util.ui.TachometerView
                            android:id="@+id/podium_percentage_tachometer_driver"
                            android:layout_width="120dp"
                            android:layout_height="120dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:layout_weight="1"
                            android:background="@color/subtle_white_border" />

                        <ImageView
                            android:id="@+id/driver_number_image"
                            android:layout_width="@dimen/driver_photo_in_card"
                            android:layout_height="@dimen/driver_photo_in_card"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:layout_weight="1"
                            android:background="@color/subtle_white_border" />

                    </LinearLayout>

                </LinearLayout>

                <!-- DRIVER HISTORY CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/driver_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/card_surface_elevated"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/subtle_white_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Title -->
                        <TextView
                            android:id="@+id/driver_history_title"
                            style="@style/t18UpperCaseBoldWhite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/driver_history_index" />

                        <!-- Subtle Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/subtle_white_border" />

                        <!-- History Table -->
                        <TableLayout
                            android:id="@+id/history_table"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*">

                        </TableLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/loading_screen"
        layout="@layout/loading_screen"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>