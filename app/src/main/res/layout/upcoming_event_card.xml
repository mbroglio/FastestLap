<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/upcoming_events_card_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/medium_margin"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="@dimen/medium_margin"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_surface_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:rippleColor="#20FFFFFF"
    app:strokeColor="@color/subtle_white_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Column: Track Layout -->
        <LinearLayout
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/upcoming_track_outline"
                android:layout_width="74dp"
                android:layout_height="70dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- Vertical Subtle Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:background="@color/subtle_white_border" />

        <!-- Right Column: Confirmed / Cancelled Layout Container -->
        <FrameLayout
            android:id="@+id/event_info_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <include
                android:id="@+id/eventConfirmed"
                layout="@layout/upcoming_event_confirmed_layout" />

            <include
                android:id="@+id/eventCancelled"
                layout="@layout/upcoming_event_cancelled_layout"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
