<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_constructor_bio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_color"
    tools:context=".ui.bio.ConstructorBioActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            app:menu="@menu/bio_menu"
            app:navigationIcon="@drawable/arrow_back_ios_style">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/topAppBarTitle"
                    style="@style/t25UpperCaseBoldBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:maxLines="1">

                </TextView>

            </RelativeLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/constructor_bio_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/screen_background_color"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar_layout">

        <ScrollView
            android:id="@+id/constructor_bio_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/screen_background_color"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/team_logo_and_flag"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.65">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/team_logo_card"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="5dp"
                            app:cardBackgroundColor="@color/timer_gray"
                            app:strokeWidth="3dp">

                            <ImageView
                                android:id="@+id/team_logo_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="8dp"
                                android:importantForAccessibility="no">

                            </ImageView>

                        </com.google.android.material.card.MaterialCardView>

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.35">

                        <ImageView
                            android:id="@+id/team_flag"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="16dp"
                            android:importantForAccessibility="no">

                        </ImageView>

                    </RelativeLayout>

                </LinearLayout>

                <ImageView
                    android:id="@+id/team_car_image"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no">

                </ImageView>

                <LinearLayout
                    android:id="@+id/team_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/t18UpperCaseBoldWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drivers_index">

                    </TextView>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp">

                        <LinearLayout
                            android:id="@+id/driver_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/driver_1_card"
                                android:layout_width="@dimen/driver_photo_in_card"
                                android:layout_height="@dimen/driver_photo_in_card"
                                android:layout_gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                app:strokeColor="@color/black"
                                app:strokeWidth="3dp">

                                <ImageView
                                    android:id="@+id/driver_1_image"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="5dp"
                                    android:importantForAccessibility="no">

                                </ImageView>

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/driver_1_name"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/not_found">

                            </TextView>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/driver_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="70dp"
                            android:layout_toEndOf="@id/driver_1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/driver_2_card"
                                android:layout_width="@dimen/driver_photo_in_card"
                                android:layout_height="@dimen/driver_photo_in_card"
                                android:layout_gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                app:strokeColor="@color/black"
                                app:strokeWidth="3dp">

                                <ImageView
                                    android:id="@+id/driver_2_image"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="5dp"
                                    android:importantForAccessibility="no">

                                </ImageView>

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/driver_2_name"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/not_found">

                            </TextView>

                        </LinearLayout>

                    </RelativeLayout>

                    <TextView
                        style="@style/t18UpperCaseBoldWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/team_info_index">

                    </TextView>

                    <LinearLayout
                        android:id="@+id/team_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_full_name_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/full_name_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_full_name_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="2dp"
                                android:layout_toEndOf="@id/team_full_name_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_base_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/base_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_base_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="2dp"
                                android:layout_toEndOf="@id/team_base_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_principal_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/team_principal_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_principal_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@id/team_principal_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_chassis_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/chassis_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_chassis_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@id/team_chassis_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_power_unit_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/power_unit_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_power_unit_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@id/team_power_unit_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_first_entry_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/first_entry_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_first_entry_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@id/team_first_entry_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_championships_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/world_championships_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_championships_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@id/team_championships_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_wins_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/wins_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_wins_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@id/team_wins_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/team_podiums_text"
                                style="@style/t14BoldWhiteLineLimited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:text="@string/podiums_index">

                            </TextView>

                            <TextView
                                android:id="@+id/team_podiums_value"
                                style="@style/t12RegularWhiteLineLimited"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="20dp"
                                android:layout_toEndOf="@id/team_podiums_text"
                                android:gravity="start"
                                android:text="@string/not_found">

                            </TextView>

                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.the_coffe_coders.fastestlap.util.ui.TachometerView
                            android:id="@+id/win_percentage_tachometer_team"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="52dp" />

                        <com.the_coffe_coders.fastestlap.util.ui.TachometerView
                            android:id="@+id/podium_percentage_tachometer_team"
                            android:layout_width="120dp"
                            android:layout_height="120dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/team_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/t18UpperCaseBoldWhite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/team_history_index" />

                        <TableLayout
                            android:id="@+id/history_table"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="3dp">

                        </TableLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/loading_screen"
        layout="@layout/loading_screen"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
