<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_constructor_bio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_color"
    tools:context=".ui.bio.ConstructorBioActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            app:menu="@menu/bio_menu"
            app:navigationIcon="@drawable/arrow_back_ios_style">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/topAppBarTitle"
                    style="@style/t25UpperCaseBoldBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:maxLines="1" />

            </RelativeLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/constructor_bio_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/screen_background_color"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar_layout">

        <ScrollView
            android:id="@+id/constructor_bio_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/screen_background_color"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- UNIFIED CONSTRUCTOR INFO CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/team_info_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/card_surface_elevated"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/subtle_white_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- TEAM FULL NAME AT THE TOP OF THE CARD WITH AUTO-RESIZE -->
                        <TextView
                            android:id="@+id/team_full_name_value"
                            style="@style/t20BoldWhite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginBottom="12dp"
                            android:maxLines="1"
                            android:text="@string/not_found" />

                        <!-- SECTION 1: TEAM LOGO & FLAG -->
                        <LinearLayout
                            android:id="@+id/team_logo_and_flag"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.65">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/team_logo_card"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="2dp"
                                    app:cardBackgroundColor="@color/team_card_modern_gray"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="2dp"
                                    app:strokeColor="@color/subtle_white_border"
                                    app:strokeWidth="1.5dp">

                                    <ImageView
                                        android:id="@+id/team_logo_image"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_margin="8dp"
                                        android:importantForAccessibility="no"
                                        android:scaleType="fitCenter" />

                                </com.google.android.material.card.MaterialCardView>

                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.35">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/team_flag_card"
                                    android:layout_width="54dp"
                                    android:layout_height="36dp"
                                    android:layout_centerInParent="true"
                                    app:cardBackgroundColor="@color/card_surface_elevated"
                                    app:cardCornerRadius="6dp"
                                    app:cardElevation="2dp"
                                    app:strokeColor="@color/subtle_white_border"
                                    app:strokeWidth="1dp">

                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/team_flag"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:importantForAccessibility="no"
                                        android:scaleType="centerCrop"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.FastestLap.RoundedFlag" />

                                </com.google.android.material.card.MaterialCardView>

                            </RelativeLayout>

                        </LinearLayout>

                        <!-- SEPARATOR: LOGO/FLAG TO CAR -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/subtle_white_border" />

                        <!-- SECTION 2: TEAM CAR IMAGE -->
                        <ImageView
                            android:id="@+id/team_car_image"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter" />

                        <!-- SEPARATOR: CAR TO (TEAM INFO + DRIVERS) -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/subtle_white_border" />

                        <!-- SECTION 3: PARALLEL DRIVERS AND TEAM INFO -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- LEFT COLUMN: DRIVERS (UNA SOTTO L'ALTRA CENTRATE VERTICALMENTE) -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.85"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/drivers_title"
                                    style="@style/t12UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/drivers_index" />

                                <!-- CONTAINER CENTRATO TRA IL TITOLO DRIVERS E LA FINE DELLA CARD -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <!-- Driver 1 -->
                                    <LinearLayout
                                        android:id="@+id/driver_1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_horizontal"
                                        android:orientation="vertical">

                                        <com.google.android.material.card.MaterialCardView
                                            android:id="@+id/driver_1_card"
                                            android:layout_width="92dp"
                                            android:layout_height="92dp"
                                            android:clickable="true"
                                            android:focusable="true"
                                            app:cardBackgroundColor="@color/card_surface_dark"
                                            app:cardCornerRadius="16dp"
                                            app:cardElevation="3dp"
                                            app:strokeColor="@color/subtle_white_border"
                                            app:strokeWidth="1.5dp">

                                            <ImageView
                                                android:id="@+id/driver_1_image"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_margin="8dp"
                                                android:importantForAccessibility="no"
                                                android:scaleType="fitCenter" />

                                        </com.google.android.material.card.MaterialCardView>

                                        <TextView
                                            android:id="@+id/driver_1_name"
                                            style="@style/t12BoldWhiteLineLimited"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:gravity="center"
                                            android:maxWidth="96dp"
                                            android:text="@string/not_found" />

                                    </LinearLayout>

                                    <!-- Spacing between Driver 1 and Driver 2 -->
                                    <Space
                                        android:layout_width="match_parent"
                                        android:layout_height="14dp" />

                                    <!-- Driver 2 -->
                                    <LinearLayout
                                        android:id="@+id/driver_2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_horizontal"
                                        android:orientation="vertical">

                                        <com.google.android.material.card.MaterialCardView
                                            android:id="@+id/driver_2_card"
                                            android:layout_width="92dp"
                                            android:layout_height="92dp"
                                            android:clickable="true"
                                            android:focusable="true"
                                            app:cardBackgroundColor="@color/card_surface_dark"
                                            app:cardCornerRadius="16dp"
                                            app:cardElevation="3dp"
                                            app:strokeColor="@color/subtle_white_border"
                                            app:strokeWidth="1.5dp">

                                            <ImageView
                                                android:id="@+id/driver_2_image"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_margin="8dp"
                                                android:importantForAccessibility="no"
                                                android:scaleType="fitCenter" />

                                        </com.google.android.material.card.MaterialCardView>

                                        <TextView
                                            android:id="@+id/driver_2_name"
                                            style="@style/t12BoldWhiteLineLimited"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:gravity="center"
                                            android:maxWidth="96dp"
                                            android:text="@string/not_found" />

                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                            <!-- VERTICAL DIVIDER -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="8dp"
                                android:layout_marginBottom="4dp"
                                android:background="@color/subtle_white_border" />

                            <!-- RIGHT COLUMN: TEAM INFO -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.15"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/team_info_title"
                                    style="@style/t12UpperCaseBoldWhiteLineLimited"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/team_info_index" />

                                <LinearLayout
                                    android:id="@+id/team_stats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="vertical">

                                    <!-- HQ / Base -->
                                    <TextView
                                        android:id="@+id/team_base_text"
                                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="start"
                                        android:text="@string/base_index"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/team_base_value"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="start"
                                        android:text="@string/not_found" />

                                    <!-- Team Principal -->
                                    <TextView
                                        android:id="@+id/team_principal_text"
                                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="start"
                                        android:text="@string/team_principal_index"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/team_principal_value"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="start"
                                        android:text="@string/not_found" />

                                    <!-- Chassis -->
                                    <TextView
                                        android:id="@+id/team_chassis_text"
                                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="start"
                                        android:text="@string/chassis_index"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/team_chassis_value"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="start"
                                        android:text="@string/not_found" />

                                    <!-- Power Unit -->
                                    <TextView
                                        android:id="@+id/team_power_unit_text"
                                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="start"
                                        android:text="@string/power_unit_index"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/team_power_unit_value"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="start"
                                        android:text="@string/not_found" />

                                    <!-- First Entry -->
                                    <TextView
                                        android:id="@+id/team_first_entry_text"
                                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="start"
                                        android:text="@string/first_entry_index"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/team_first_entry_value"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="start"
                                        android:text="@string/not_found" />

                                    <!-- World Championships -->
                                    <TextView
                                        android:id="@+id/team_championships_text"
                                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="start"
                                        android:text="@string/world_championships_index"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/team_championships_value"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="start"
                                        android:text="@string/not_found" />

                                    <!-- Wins -->
                                    <TextView
                                        android:id="@+id/team_wins_text"
                                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="start"
                                        android:text="@string/wins_index"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/team_wins_value"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="start"
                                        android:text="@string/not_found" />

                                    <!-- Podiums -->
                                    <TextView
                                        android:id="@+id/team_podiums_text"
                                        style="@style/t10UpperCaseBoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="start"
                                        android:text="@string/podiums_index"
                                        android:textColor="@color/timer_gray" />

                                    <TextView
                                        android:id="@+id/team_podiums_value"
                                        style="@style/t12BoldWhiteLineLimited"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:gravity="start"
                                        android:text="@string/not_found" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- TACHOMETERS (OUTSIDE CARD) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.the_coffe_coders.fastestlap.util.ui.TachometerView
                        android:id="@+id/win_percentage_tachometer_team"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="52dp" />

                    <com.the_coffe_coders.fastestlap.util.ui.TachometerView
                        android:id="@+id/podium_percentage_tachometer_team"
                        android:layout_width="120dp"
                        android:layout_height="120dp" />

                </LinearLayout>

                <!-- CONSTRUCTOR HISTORY CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/team_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/card_surface_elevated"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/subtle_white_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Title -->
                        <TextView
                            android:id="@+id/team_history_title"
                            style="@style/t18UpperCaseBoldWhite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/team_history_index" />

                        <!-- Subtle Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/subtle_white_border" />

                        <!-- History Table -->
                        <TableLayout
                            android:id="@+id/history_table"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*">

                        </TableLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/loading_screen"
        layout="@layout/loading_screen"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
