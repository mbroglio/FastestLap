<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".ui.bio.TrackBioActivity">

    <LinearLayout
        android:id="@+id/track_history_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="9dp"
        android:paddingEnd="8dp"
        android:paddingBottom="9dp">

        <!-- Season Year -->
        <TextView
            android:id="@+id/season_year"
            style="@style/t12BoldWhiteLineLimited"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/not_found"
            android:textColor="@color/white" />

        <!-- Podium Details (1st, 2nd, 3rd) -->
        <LinearLayout
            android:id="@+id/race_podium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 1st Place -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/t12BoldWhiteLineLimited"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/_1_numeric"
                    android:textColor="#FFD700" />

                <TextView
                    android:id="@+id/first_driver"
                    style="@style/t12BoldWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/not_found"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/t10RegularWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/separator_high_dash"
                    android:textColor="@color/timer_gray" />

                <TextView
                    android:id="@+id/first_driver_team"
                    style="@style/t10RegularWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/not_found"
                    android:textColor="@color/timer_gray" />

            </LinearLayout>

            <!-- 2nd Place -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/t12BoldWhiteLineLimited"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/_2_numeric"
                    android:textColor="#C0C0C0" />

                <TextView
                    android:id="@+id/second_driver"
                    style="@style/t12BoldWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/not_found"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/t10RegularWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/separator_high_dash"
                    android:textColor="@color/timer_gray" />

                <TextView
                    android:id="@+id/second_driver_team"
                    style="@style/t10RegularWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/not_found"
                    android:textColor="@color/timer_gray" />

            </LinearLayout>

            <!-- 3rd Place -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/t12BoldWhiteLineLimited"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/_3_numeric"
                    android:textColor="#CD7F32" />

                <TextView
                    android:id="@+id/third_driver"
                    style="@style/t12BoldWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/not_found"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/t10RegularWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/separator_high_dash"
                    android:textColor="@color/timer_gray" />

                <TextView
                    android:id="@+id/third_driver_team"
                    style="@style/t10RegularWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/not_found"
                    android:textColor="@color/timer_gray" />

            </LinearLayout>

        </LinearLayout>

        <!-- Race Highlights Button (YouTube icon) -->
        <ImageView
            android:id="@+id/race_highlights_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/youtube_icon"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/subtle_white_border" />

</LinearLayout>