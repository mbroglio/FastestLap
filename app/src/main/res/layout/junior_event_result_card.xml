<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/junior_event_result_card_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/medium_margin"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="@dimen/medium_margin"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/card_surface_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:rippleColor="@color/ripple_color"
    app:strokeColor="@color/formula_2"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Flag, Round, Circuit Name -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/event_nation_flag"
                android:layout_width="44dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.FastestLap.RoundedFlag"
                app:strokeColor="@color/subtle_white_border"
                app:strokeWidth="1dp" />

            <!-- Spacer on the right to balance flag and keep center text centered -->
            <View
                android:id="@+id/empty_space_centering"
                android:layout_width="44dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/empty_space_centering"
                android:layout_toEndOf="@id/event_nation_flag"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/round_number"
                    style="@style/t10UpperCaseBoldWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:textColor="@color/formula_2"
                    tools:text="ROUND 1" />

                <TextView
                    android:id="@+id/gp_name"
                    style="@style/t14BoldWhiteLineLimited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    tools:text="Albert Park Grand Prix Circuit" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Subtle Horizontal Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/subtle_white_border" />

        <!-- Row 1: Sprint & Feature 1 (Side-by-Side) -->
        <LinearLayout
            android:id="@+id/row_1_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Sprint Race -->
            <LinearLayout
                android:id="@+id/sprint_race_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/sprint_title"
                    style="@style/t12UpperCaseBoldWhiteLineLimited"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/sprint"
                    android:textColor="@color/modern_light_gray" />

                <FrameLayout
                    android:id="@+id/sprint_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <include
                        android:id="@+id/sprint_podium"
                        layout="@layout/junior_race_podium_event_card"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/sprint_cancelled"
                        layout="@layout/junior_race_cancelled_layout_white"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/sprint_yet_to_start"
                        layout="@layout/junior_race_yet_to_start_layout_white"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/sprint_error"
                        layout="@layout/junior_race_error_layout_white"
                        android:visibility="visible" />

                </FrameLayout>

            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/subtle_white_border" />

            <!-- Feature 1 Race -->
            <LinearLayout
                android:id="@+id/feature1_race_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/feature1_title"
                    style="@style/t12UpperCaseBoldWhiteLineLimited"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/feature"
                    android:textColor="@color/modern_light_gray" />

                <FrameLayout
                    android:id="@+id/feature1_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <include
                        android:id="@+id/feature1_podium"
                        layout="@layout/junior_race_podium_event_card"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/feature1_cancelled"
                        layout="@layout/junior_race_cancelled_layout_white"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/feature1_yet_to_start"
                        layout="@layout/junior_race_yet_to_start_layout_white"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/feature1_error"
                        layout="@layout/junior_race_error_layout_white"
                        android:visibility="visible" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: Feature 2 (Shown only for double feature weekends) -->
        <LinearLayout
            android:id="@+id/feature2_row_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Horizontal Divider between Row 1 and Row 2 -->
            <View
                android:id="@+id/feature2_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/subtle_white_border" />

            <!-- Feature 2 Race -->
            <LinearLayout
                android:id="@+id/feature2_race_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/feature2_title"
                    style="@style/t12UpperCaseBoldWhiteLineLimited"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/feature_2"
                    android:textColor="@color/modern_light_gray" />

                <FrameLayout
                    android:id="@+id/feature2_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <include
                        android:id="@+id/feature2_podium"
                        layout="@layout/junior_race_podium_event_card"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/feature2_cancelled"
                        layout="@layout/junior_race_cancelled_layout_white"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/feature2_yet_to_start"
                        layout="@layout/junior_race_yet_to_start_layout_white"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/feature2_error"
                        layout="@layout/junior_race_error_layout_white"
                        android:visibility="visible" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Optional Pending Results Layout if needed -->
        <TextView
            android:id="@+id/pending_results_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/orbitron_bold"
            android:text="@string/pending_results"
            android:textColor="@color/white"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
