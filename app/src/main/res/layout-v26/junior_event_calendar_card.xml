<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/junior_event_calendar_card_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/medium_margin"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="@dimen/medium_margin"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/grey_card"
    app:strokeColor="@color/black"
    app:strokeWidth="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="5dp">

            <TextView
                android:id="@+id/gp_round_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"
                android:fontFamily="@font/orbitron_bold"
                android:text="@string/not_found"
                android:textColor="@color/white"
                android:textSize="@dimen/text_minor_importance_size"
                android:textStyle="bold">

            </TextView>

            <TextView
                android:id="@+id/gp_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/gp_round_number"
                android:layout_centerInParent="true"
                android:autoSizeMaxTextSize="@dimen/layout_subtitle_text_size"
                android:autoSizeMinTextSize="@dimen/min_text_resize_1"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/orbitron_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/not_found"
                android:textColor="@color/white"
                android:textSize="@dimen/layout_subtitle_text_size">

            </TextView>

            <LinearLayout
                android:id="@+id/results_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/gp_name"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/sprint_race_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="@dimen/body_text_size"
                        android:autoSizeMinTextSize="@dimen/min_text_resize_1"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/sprint_upper_case"
                        android:textColor="@color/white"
                        android:textSize="@dimen/body_text_size">

                    </TextView>

                    <TextView
                        android:id="@+id/sprint_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/orbitron_regular"
                        android:text="@string/not_found"
                        android:textColor="@color/white"
                        android:textSize="@dimen/body_text_size">

                    </TextView>

                    <TextView
                        android:id="@+id/sprint_month"
                        style="@style/LayoutSubtitleUppercaseWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/not_found">

                    </TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:background="@color/white">

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/feature_race_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="@dimen/body_text_size"
                        android:autoSizeMinTextSize="@dimen/min_text_resize_1"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/feature_upper_case"
                        android:textColor="@color/white"
                        android:textSize="@dimen/body_text_size">

                    </TextView>

                    <TextView
                        android:id="@+id/feature_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/orbitron_regular"
                        android:text="@string/not_found"
                        android:textColor="@color/white"
                        android:textSize="@dimen/body_text_size">

                    </TextView>

                    <TextView
                        android:id="@+id/feature_month"
                        style="@style/LayoutSubtitleUppercaseWhite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/not_found">

                    </TextView>

                </LinearLayout>

            </LinearLayout>


            <!--
            <ImageView
                android:id="@+id/past_event_card_arrow"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:importantForAccessibility="no"
                android:visibility="visible"
                android:layout_marginTop="5dp"
                android:layout_below="@id/results_layout"
                app:srcCompat="@drawable/play_icon_white">

            </ImageView>
            -->

        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

