<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="OrbitronBold_AutoSize_top_bar">
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/orbitron_bold</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">20sp</item>
    </style>

    <style name="JuniorCardTitle">
        <item name="android:textSize">@dimen/page_title_text_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDx">10</item>
        <item name="android:shadowDy">10</item>
        <item name="android:shadowRadius">4</item>
        <item name="fontFamily">@font/orbitron_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:autoSizeMaxTextSize">@dimen/page_title_text_size</item>
        <item name="android:autoSizeMinTextSize">@dimen/min_text_resize_1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="maxLines">2</item>
    </style>


</resources>