<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/f3_navigation"
    app:startDestination="@id/f3HomeFragment">

    <fragment
        android:id="@+id/f3HomeFragment"
        android:name="com.the_coffe_coders.fastestlap.ui.junior.fragment.F3HomeFragment"
        android:label="@string/formula_3"
        tools:layout="@layout/fragment_f3_home" >
        <action
            android:id="@+id/to_carBio_formula3"
            app:destination="@id/f3CarBioFragment" />
        <action
            android:id="@+id/to_juniorResults_formula3"
            app:destination="@id/juniorResultsFragment" />
    </fragment>

    <fragment
        android:id="@+id/f3CarBioFragment"
        android:name="com.the_coffe_coders.fastestlap.ui.junior.fragment.F3CarBioFragment"
        android:label="@string/the_formula_3_car"
        tools:layout="@layout/fragment_f3_car_bio" >
    </fragment>

    <fragment
        android:id="@+id/juniorResultsFragment"
        android:name="com.the_coffe_coders.fastestlap.ui.junior.fragment.JuniorResultsFragment"
        android:label="@string/results"
        tools:layout="@layout/fragment_junior_results" >

    </fragment>

</navigation>

